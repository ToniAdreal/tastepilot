.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Share-link persistence files (TASTEPILOT_SHARE_FILE) hold shared plans
*.shares.json
tastepilot-shares.json

# Preference-profile persistence files (TASTEPILOT_PROFILE_FILE) hold
# owner-token hashes and derived profiles — never commit them either
*.profiles.json
tastepilot-profiles.json

# Calendar-feed persistence files (TASTEPILOT_FEED_FILE /
# TASTEPILOT_MULTI_FEED_FILE) hold stored timelines and owner-token
# hashes — never commit them either
*.feeds.json
tastepilot-feeds.json
*.multifeeds.json
tastepilot-multifeeds.json
